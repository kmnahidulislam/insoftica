# Contact form email settings. Copy to .env for local use; on the host set
# these as environment variables. Never commit the real values.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=no-reply@portal.insoftica.com
SMTP_PASS=
# Where contact-form messages are delivered.
CONTACT_TO=support@insoftica.com
# The address messages are sent from. Must be allowed by the SMTP account.
CONTACT_FROM=no-reply@portal.insoftica.com

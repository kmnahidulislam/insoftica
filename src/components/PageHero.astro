---
/**
 * Standard header for inner pages. `tone="dark"` renders on Ink.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  tone?: 'light' | 'dark';
}
const { eyebrow, title, lead, tone = 'light' } = Astro.props;
---

<section class:list={['page-hero', { 'on-dark': tone === 'dark', dots: tone === 'dark' }]}>
  <div class="container">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="h1 reveal" style="--reveal-delay:60ms">{title}</h1>
    {lead && <p class="lead reveal" style="--reveal-delay:120ms">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .page-hero.on-dark {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .page-hero .eyebrow {
    margin-bottom: 20px;
  }

  .page-hero h1 {
    max-width: 22ch;
  }

  .page-hero .lead {
    max-width: 58ch;
    margin-top: 22px;
  }
</style>

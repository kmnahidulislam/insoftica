---
/**
 * Brand wordmark. `tone` picks the colour for light or dark surfaces.
 */
interface Props {
  tone?: 'light' | 'dark';
  height?: number;
  class?: string;
}
const { tone = 'light', height = 22, class: className = '' } = Astro.props;
const wordmark = tone === 'dark' ? '/brand/insoftica-2.png' : '/brand/insoftica-blue.png';
const width = Math.round(height * (tone === 'dark' ? 1360 / 273 : 1596 / 286));
---

<img class={`logo ${className}`} src={wordmark} width={width} height={height} alt="Insoftica" style={`height:${height}px`} />

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>

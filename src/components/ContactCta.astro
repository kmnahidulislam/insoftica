---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Let's talk about what you're building.",
  text = 'Whether you want to work with us, partner with us or simply hear when our first products launch, we read every message.',
} = Astro.props;
---

<section class="cta section">
  <div class="container cta__inner reveal">
    <div class="cta__module" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <h2 class="h2">{title}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a href="/contact" class="btn btn--primary">
        Talk to us
        <Icon name="arrow-right" size={16} />
      </a>
      <a href={`mailto:${site.email}`} class="btn btn--ghost">{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(40px, 6vw, 80px);
    max-width: 100%;
  }

  .cta__inner h2 {
    max-width: 18ch;
  }

  .cta__inner .lead {
    max-width: 52ch;
    margin: 18px 0 32px;
  }

  .cta__module {
    position: absolute;
    right: clamp(-40px, -2vw, 24px);
    top: 50%;
    transform: translateY(-50%) rotate(8deg);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: clamp(180px, 22vw, 280px);
    aspect-ratio: 1;
    opacity: 0.08;
    pointer-events: none;
  }

  .cta__module span {
    background: var(--indigo);
    border-radius: 10px;
  }

  .cta__module span:nth-child(3) {
    border-radius: 50%;
  }

  .cta__module span:nth-child(4),
  .cta__module span:nth-child(6) {
    visibility: hidden;
  }

  @media (max-width: 760px) {
    .cta__module {
      display: none;
    }
  }
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, footerNav, addressLines } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__cta">
    <div class="container footer__cta-inner">
      <div class="reveal">
        <h2 class="footer__cta-title">Have something worth building?</h2>
        <p class="footer__cta-text">Tell us about it. We reply to every message, usually within two working days.</p>
      </div>
      <div class="footer__cta-actions reveal" style="--reveal-delay:80ms">
        <a href="/contact" class="btn btn--primary">
          Start a project
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={`mailto:${site.email}`} class="btn btn--ghost">{site.email}</a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo height={22} />
        <p class="footer__blurb">
          Software products and AI-powered tools, built and operated in London for customers in the UK and worldwide.
        </p>
        <address class="footer__address">
          {site.legalName}<br />
          {addressLines.map((l, i) => (<>{l}{i < addressLines.length - 1 && <br />}</>))}
        </address>
      </div>

      {
        Object.entries(footerNav).map(([title, links]) => (
          <div class="footer__col">
            <h2>{title}</h2>
            <ul role="list">
              {links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.legalName}. Registered in England and Wales.</p>
      <div class="footer__meta">
        {
          site.social.github && (
            <a href={site.social.github} rel="noopener" aria-label="Insoftica on GitHub" class="footer__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
            </a>
          )
        }
        <a href={`mailto:${site.email}`} aria-label="Email Insoftica" class="footer__icon"><Icon name="mail" size={16} /></a>
        <span class="footer__sep" aria-hidden="true"></span>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--canvas);
  }

  .footer__cta {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .footer__cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(36px, 5vw, 56px) 0;
  }

  .footer__cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .footer__cta-text {
    margin-top: 8px;
    color: var(--slate);
    max-width: 46ch;
  }

  .footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 40px;
    padding: clamp(48px, 6vw, 72px) 0 40px;
  }

  .footer__blurb {
    margin-top: 18px;
    max-width: 30ch;
    font-size: 0.925rem;
    color: var(--slate);
  }

  .footer__address {
    margin-top: 18px;
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--slate);
  }

  .footer__col h2 {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
    color: var(--ink);
  }

  .footer__col li + li {
    margin-top: 9px;
  }

  .footer__col a {
    font-size: 0.9rem;
    color: var(--slate);
    transition: color 0.15s;
  }

  .footer__col a:hover {
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 22px 0 32px;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--slate-light);
  }

  .footer__meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer__meta a {
    color: var(--slate);
    transition: color 0.15s;
  }

  .footer__meta a:hover {
    color: var(--ink);
  }

  .footer__icon {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .footer__sep {
    width: 1px;
    height: 16px;
    background: var(--line-strong);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .footer__cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }
</style>

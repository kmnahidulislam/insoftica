---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import AiPipeline from '../components/AiPipeline.astro';
import Faq from '../components/Faq.astro';
import WorkLoop from '../components/WorkLoop.astro';
import Illus from '../components/Illus.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { products, productAreas, statusLabel } from '../data/products';

const ticker = [
  'TypeScript',
  'Node.js',
  'React',
  'PostgreSQL',
  'Python',
  'LLM APIs',
  'Retrieval-augmented generation',
  'Infrastructure as code',
  'Containers',
  'Edge caching',
  'Automated testing',
  'Observability',
];

const jobs = [
  {
    icon: 'box',
    title: 'Products we build',
    text: 'Our own web applications, SaaS platforms and tools, designed for an international audience and operated by us for the long term.',
    href: '/products',
    link: 'See what we are building',
  },
  {
    icon: 'sparkle',
    title: 'AI applied to real work',
    text: 'Language models and machine learning used inside products where they save time or improve results, always with a person in control.',
    href: '/technology#ai',
    link: 'How we use AI',
  },
  {
    icon: 'layers',
    title: 'Engineering for businesses',
    text: 'Custom software, platforms and integrations for organisations that need something more dependable than an off-the-shelf tool.',
    href: '/solutions',
    link: 'Explore solutions',
  },
] as const;

const models = [
  {
    title: 'Product build',
    text: 'We take a defined product from idea to launch: discovery, design, engineering, infrastructure and the first months of operation.',
    bullets: ['Fixed scope or phased', 'Weekly demos', 'You own the code and infrastructure'],
  },
  {
    title: 'Team extension',
    text: 'Senior engineers join your existing team for a period, working in your repositories and your process.',
    bullets: ['Part-time or full-time', 'Minimum one month', 'Direct access, no account managers'],
  },
  {
    title: 'Technical advisory',
    text: 'Architecture reviews, AI feasibility assessments and second opinions before you commit budget.',
    bullets: ['Written findings', 'One to three weeks', 'Vendor-neutral'],
  },
];

const steps = [
  ['Understand', 'We start with the problem, the people who have it and what a good outcome looks like. If software is not the answer, we say so.'],
  ['Design', 'Flows and interfaces are drawn, challenged and tested before anything is built. Clarity first, decoration later.'],
  ['Build', 'Small releases, reviewed code, automated checks. Working software early, then refined with the people using it.'],
  ['Operate', 'Launch is the start. We monitor, support and improve products for as long as they are in use.'],
];

const capabilities = [
  { illus: 'dashboard', title: 'Web applications and dashboards', text: 'Multi-user products with roles, reporting and the admin tooling that real operations need.' },
  { illus: 'search', title: 'AI assistants with citations', text: 'Answers grounded in your own documents and data, with sources shown and a person reviewing.' },
  { illus: 'automation', title: 'Workflow automation', text: 'Rules, triggers and queues that remove repetitive steps without hiding what happened.' },
  { illus: 'integrations', title: 'Integrations and APIs', text: 'Payments, CRMs, accounting, internal databases: connected cleanly, with webhooks and audit.' },
  { illus: 'billing', title: 'Subscriptions and billing', text: 'Plans, usage metering, invoices and the edge cases that make SaaS billing hard.' },
  { illus: 'mobile', title: 'Mobile and progressive web apps', text: 'One codebase that works properly on phones, tablets and desktops, online and off.' },
] as const;

const readiness = [
  { illus: 'integrations', title: 'Integrates with what you run', text: 'REST and webhook integrations with the systems you already use. Data moves on a schedule or in real time, and every transfer is logged.' },
  { illus: 'security', title: 'Secure by default', text: 'Encryption in transit and at rest, least-privilege access, UK and EU data regions, dependency scanning on every release.' },
  { illus: 'support', title: 'Supported by the people who built it', text: 'Direct access to the engineers. Documentation written as the product is built, not after. Incident runbooks ready before launch.' },
] as const;

const faq: [string, string][] = [
  ['Does Insoftica have products I can use today?', 'Not yet. The first products are in development and are listed on the Products page with their status. We will only describe a product as available when you can actually sign up for it.'],
  ['Where is data hosted?', 'By default in UK and EU cloud regions. For client projects we host where your data protection obligations require, and we document it.'],
  ['Who owns the code you write for us?', 'You do. Source code, infrastructure definitions and documentation are handed over in full. We ask only to keep generic tooling we built before your project.'],
  ['How do you price work?', 'Product builds are priced per phase with a written scope. Team extension is a monthly rate. Advisory work is a fixed fee. Every engagement starts with a written proposal.'],
  ['Do you work with companies outside the UK?', 'Yes. We are registered in London and work with businesses internationally. Most collaboration happens over video and shared tooling.'],
];
---

<Base title="Home" description={site.description} isHome faq={faq}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__band" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="display reveal" style="--reveal-delay:60ms">
          Software <span class="hl">worth</span> building.
        </h1>
        <p class="lead reveal" style="--reveal-delay:120ms">
          Insoftica builds its own software products and AI-powered tools, and engineers platforms for
          businesses that need them built properly. Based in London, working internationally.
        </p>
        <div class="btn-row reveal" style="--reveal-delay:180ms">
          <a href="/contact" class="btn btn--primary">
            Start a project
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="/products" class="btn btn--ghost">What we're building</a>
        </div>
      </div>
      <div class="hero__visual">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- Capability ticker -->
  <div class="ticker" aria-label="Technologies we work with">
    <div class="ticker__track">
      {[...ticker, ...ticker].map((t) => (<span class="ticker__item"><i></i>{t}</span>))}
    </div>
  </div>

  <!-- Intro statement -->
  <section class="section intro">
    <div class="container intro__inner">
      <div class="reveal">
        <p class="eyebrow">A product company at the start of its portfolio</p>
        <h2 class="h2">We build and operate software of our own, and apply the same engineering to work for other businesses.</h2>
      </div>
      <div class="intro__text reveal" style="--reveal-delay:100ms">
        <p>
          Most companies that write software do it for clients. Insoftica is organised around products: web
          applications, platforms and AI-powered tools that we design, build, run and improve ourselves. That
          is where the company is headed, and it shapes how we work with everyone else.
        </p>
        <p>
          The portfolio is new and we are honest about that. What you will find here is what we are building,
          how we build it, and how to reach us.
        </p>
        <dl class="facts">
          <div><dt>Founded</dt><dd>{site.foundedYear}, London</dd></div>
          <div><dt>Focus</dt><dd>Software, AI, digital products</dd></div>
          <div><dt>Markets</dt><dd>UK and international</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Three jobs -->
  <section class="section section--alt jobs">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">What we do</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Three kinds of work, one engineering standard.</h2>
      </div>
      <div class="grid grid--3">
        {
          jobs.map((j, i) => (
            <a href={j.href} class="card job reveal" style={`--reveal-delay:${i * 80}ms`}>
              <span class="job__icon">
                <Icon name={j.icon} size={22} />
              </span>
              <h3 class="h3">{j.title}</h3>
              <p>{j.text}</p>
              <span class="link-arrow">
                {j.link}
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section caps">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Capabilities</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">The things we build, again and again.</h2>
        <p class="lead reveal" style="--reveal-delay:120ms">Each of these has shipped before and will ship again. Together they cover most of what a modern product needs.</p>
      </div>
      <div class="grid grid--3 caps__grid">
        {
          capabilities.map((c, i) => (
            <div class="card card--lift cap reveal" style={`--reveal-delay:${i * 70}ms`}>
              <Illus name={c.illus} class="cap__illus" />
              <h3 class="h4">{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section section--alt products">
    <div class="container">
      <div class="products__head">
        <div class="section-head reveal">
          <p class="eyebrow">Products</p>
          <h2 class="h2">
            {products.length ? 'Products from Insoftica.' : 'The first products are in development.'}
          </h2>
          <p class="lead">
            {
              products.length
                ? 'Built, operated and improved by us.'
                : 'We publish products here only when they can be described truthfully. Until then, these are the areas we are working in.'
            }
          </p>
        </div>
        <a href="/products" class="link-arrow reveal">
          Products page
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      {
        products.length ? (
          <div class="grid grid--3">
            {products.map((p, i) => (
              <article class="card reveal" style={`--reveal-delay:${i * 80}ms`}>
                <span class:list={['tag', { 'tag--amber': p.status === 'in-development', 'tag--signal': p.status === 'available', 'tag--indigo': p.status === 'early-access' }]}>
                  {statusLabel[p.status]}
                </span>
                <h3 class="h3">{p.name}</h3>
                <p>{p.summary}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="rows">
            {productAreas.map((a, i) => (
              <div class="row reveal" style={`--reveal-delay:${i * 60}ms`}>
                <span class="row__num">0{i + 1}</span>
                <span class="row__title">{a.title}</span>
                <span class="row__text">{a.text}</span>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Engineering band with architecture -->
  <section class="section on-dark dots eng" id="engineering">
    <div class="container">
      <div class="eng__head">
        <div class="section-head reveal">
          <p class="eyebrow">Engineering</p>
          <h2 class="h2">Built the way software should be built.</h2>
          <p class="lead">
            This is the shape of a typical Insoftica product. Clients at the edge, a guarded API, services that
            do the work, an AI layer that is checked before it speaks, and data that is backed up and restorable.
          </p>
        </div>
        <a href="/technology" class="btn btn--ghost reveal">
          Our technology
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="eng__diagram">
        <ArchitectureDiagram tone="dark" />
      </div>
    </div>
  </section>

  <!-- AI pipeline -->
  <section class="section" id="ai">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Applied AI</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Every AI feature passes through the same five stages.</h2>
        <p class="lead reveal" style="--reveal-delay:120ms">
          A model on its own is not a product. Retrieval keeps answers grounded, evaluation keeps quality
          measurable, and review keeps a person responsible for the outcome.
        </p>
      </div>
      <AiPipeline />
    </div>
  </section>

  <!-- How we work -->
  <section class="section work">
    <div class="container work__inner">
      <div class="work__art reveal">
        <WorkLoop />
      </div>
      <div>
        <div class="section-head reveal">
          <p class="eyebrow">How we work</p>
          <h2 class="h2">Four stages, repeated as often as the product needs.</h2>
          <p class="lead">The same loop runs for our own products and for the work we do with businesses.</p>
        </div>
        <ol role="list" class="work__steps">
          {
            steps.map(([t, d], i) => (
              <li class="work__step reveal" style={`--reveal-delay:${i * 80}ms`}>
                <span class="work__num">0{i + 1}</span>
                <div>
                  <h3 class="h4">{t}</h3>
                  <p>{d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Engagement models -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Working with businesses</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Three ways to work with us.</h2>
      </div>
      <div class="grid grid--3">
        {
          models.map((m, i) => (
            <div class="card model reveal" style={`--reveal-delay:${i * 80}ms`}>
              <span class="model__num">0{i + 1}</span>
              <h3 class="h3">{m.title}</h3>
              <p>{m.text}</p>
              <ul role="list" class="model__bullets">
                {m.bullets.map((b) => (
                  <li>
                    <Icon name="check" size={14} />
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ready for business -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Ready for business</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Built to be relied on from the first day.</h2>
      </div>
      <div class="ready">
        {
          readiness.map((r, i) => (
            <div class="ready__row reveal" style={`--reveal-delay:${i * 80}ms`}>
              <div class="ready__art"><Illus name={r.illus} /></div>
              <div class="ready__copy">
                <h3 class="h3">{r.title}</h3>
                <p>{r.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h2">Things people ask before they get in touch.</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: clamp(56px, 8vw, 104px) 0 clamp(56px, 7vw, 96px);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(70% 70% at 70% 40%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 70% at 70% 40%, #000 30%, transparent 100%);
    opacity: 0.8;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    right: -10%;
    top: -20%;
    width: 60%;
    height: 90%;
    background: radial-gradient(closest-side, rgba(76, 79, 214, 0.14), transparent);
    filter: blur(20px);
  }

  .hero__band {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 58%;
    height: 26%;
    background: linear-gradient(90deg, rgba(76, 79, 214, 0.1), rgba(157, 161, 255, 0.28) 40%, rgba(224, 150, 42, 0.14) 75%, rgba(76, 79, 214, 0.06));
    transform: skewY(-6deg);
    filter: blur(28px);
    opacity: 0.9;
    pointer-events: none;
    animation: band 14s ease-in-out infinite alternate;
  }

  @keyframes band {
    to {
      transform: skewY(-6deg) translateX(4%);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }

  .hero__copy .eyebrow {
    margin-bottom: 24px;
  }

  .hero__copy h1 {
    max-width: 11ch;
  }

  .hero__copy .lead {
    max-width: 46ch;
    margin: 24px 0 32px;
  }

  .hero__visual {
    padding-top: 30px;
  }

  /* Ticker */
  .ticker {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 48s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate);
    white-space: nowrap;
  }

  .ticker__item i {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--indigo);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* Intro */
  .intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .intro .eyebrow {
    margin-bottom: 18px;
  }

  .intro__text {
    color: var(--slate);
    font-size: 1.05rem;
  }

  .intro__text p + p {
    margin-top: 1em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate-light);
    margin-bottom: 4px;
  }

  .facts dd {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  /* Jobs */
  .job {
    display: flex;
    flex-direction: column;
  }

  .job__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--indigo-tint);
    color: var(--indigo);
    margin-bottom: 22px;
    transition: transform 0.25s var(--ease), background 0.25s;
  }

  .job:hover .job__icon {
    transform: translateY(-2px) rotate(-4deg);
    background: var(--indigo);
    color: #fff;
  }

  .job p {
    flex: 1;
    margin-bottom: 22px;
  }

  /* Capabilities */
  .caps__grid {
    --grid-gap: 20px;
  }

  .cap {
    padding: 20px 20px 24px;
  }

  .cap :global(.cap__illus) {
    margin: -4px -4px 18px;
    border-radius: 12px;
    background: var(--canvas-2);
    padding: 12px;
  }

  .cap p {
    margin-top: 6px;
  }

  /* Ready */
  .ready {
    display: grid;
    gap: 20px;
  }

  .ready__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .ready__row:nth-child(even) .ready__art {
    order: 2;
  }

  .ready__art {
    padding: 8px 16px;
    border-radius: 12px;
    background: var(--canvas-2);
  }

  .ready__copy h3 {
    margin-bottom: 10px;
  }

  .ready__copy p {
    color: var(--slate);
    font-size: 1.02rem;
  }

  /* Products */
  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .products__head .section-head {
    margin-bottom: 0;
  }

  .products__head .link-arrow {
    margin-bottom: 8px;
    white-space: nowrap;
  }

  .products .rows {
    margin-top: clamp(32px, 4vw, 48px);
  }

  /* Engineering */
  .eng__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .eng__diagram {
    margin-top: 8px;
    padding: clamp(16px, 3vw, 32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
  }

  /* Models */
  .model {
    position: relative;
  }

  .model__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--indigo);
    margin-bottom: 16px;
  }

  .model__bullets {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 8px;
  }

  .model__bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--ink);
  }

  .model__bullets svg {
    color: var(--indigo);
    flex-shrink: 0;
  }

  /* Work loop */
  .work__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .work__art {
    padding: clamp(16px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .work .section-head {
    margin-bottom: 28px;
  }

  .work__steps {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .work__step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .work__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--indigo);
    padding-top: 4px;
  }

  .work__step h3 {
    margin-bottom: 4px;
  }

  .work__step p {
    color: var(--slate);
    font-size: 0.95rem;
  }

  /* FAQ */
  .faq-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .faq-wrap .section-head {
    margin-bottom: 0;
    position: sticky;
    top: 100px;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      padding: 36px 0 24px;
    }

    .hero__bg {
      mask-image: none;

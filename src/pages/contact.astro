---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import MapMark from '../components/MapMark.astro';
import { site, addressLines } from '../data/site';

const topics = ['A project for my business', 'Partnership or collaboration', 'Early access to a product', 'Press or general enquiry'];

const next = [
  ['We read it', 'A person, not a ticketing system. Usually the same day.'],
  ['We reply', 'Within two working days, with questions or a suggested call.'],
  ['We talk', 'Thirty minutes on video to understand the problem. No pitch.'],
  ['You decide', 'If it makes sense, a written proposal follows. If not, we say so.'],
];
---

<Base
  title="Contact"
  description="Contact Insoftica Ltd. Talk to us about a software or AI project, a partnership, or early access to our products. We reply to every message."
>
  <PageHero
    eyebrow="Contact"
    title="Tell us what you're working on."
    lead="Whether it is a project, a partnership or simply curiosity about what we are building, we read and answer every message, usually within two working days."
  >
    <HeroArt name="contact" email={site.email} />
  </PageHero>

  <section class="section">
    <div class="container contact">
      <form
        id="contact-form"
        class="contact__form reveal"
        method="POST"
        action={site.formEndpoint || undefined}
        data-contact-form
        data-endpoint={site.formEndpoint}
        data-mailto={site.email}
        novalidate
      >
        <div class="grid grid--2 contact__fields">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="company">Company <span class="hint">(optional)</span></label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="topic">What is this about?</label>
            <select id="topic" name="topic">
              {topics.map((t) => <option>{t}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required placeholder="A few lines is plenty. What is the problem, and what would a good outcome look like?"></textarea>
        </div>
        <!-- Honeypot for bots; hidden from people and screen readers -->
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="contact__privacy">
          We use what you send only to reply to you. See our <a href="/privacy">privacy policy</a>.
        </p>
        <div class="contact__actions">
          <button type="submit" class="btn btn--primary">
            Send message
            <Icon name="arrow-right" size={16} />
          </button>
          <p class="contact__status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="contact__aside reveal" style="--reveal-delay:100ms">
        <MapMark />
        <div class="contact__block">
          <span class="contact__icon"><Icon name="map-pin" size={20} /></span>
          <div>
            <h2>Registered office</h2>
            <address>
              <strong>{site.legalName}</strong><br />
              {addressLines.map((l, i) => (<>{l}{i < addressLines.length - 1 && <br />}</>))}
            </address>
          </div>
        </div>
        <div class="contact__block">
          <span class="contact__icon"><Icon name="building" size={20} /></span>
          <div>
            <h2>Meetings</h2>
            <p>By appointment. Most first conversations happen on video, whichever time zone you are in.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">What happens next</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">After you press send.</h2>
      </div>
      <ol role="list" class="grid grid--4 next">
        {
          next.map(([t, d], i) => (
            <li class="card card--lift reveal" style={`--reveal-delay:${i * 80}ms`}>
              <span class="next__num">0{i + 1}</span>
              <h3 class="h4">{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .panel__link {
    color: var(--indigo);
    font-weight: 600;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 40px);
  }

  .contact__fields {
    --grid-gap: 22px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact__privacy {
    font-size: 0.85rem;
    color: var(--slate-light);
  }

  .contact__privacy a {
    color: var(--indigo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .contact__status {
    font-size: 0.9rem;
    color: var(--slate);
  }

  .contact__status.is-error {
    color: #b42318;
  }

  .contact__status.is-ok {
    color: var(--signal);
  }

  .contact__aside {
    display: grid;
    gap: 28px;
  }

  .contact__block {
    display: flex;
    gap: 16px;
  }

  .contact__icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--indigo-tint);
    color: var(--indigo);
  }

  .contact__block h2 {
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .contact__block address {
    font-style: normal;
    color: var(--slate);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .contact__block address strong {
    color: var(--ink);
  }

  .contact__block p {
    color: var(--slate);
    font-size: 0.95rem;
  }

  .next__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--indigo);
    margin-bottom: 14px;
  }

  .next p {
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  const say = (msg: string, kind: 'ok' | 'error' | '' = '') => {
    if (!status) return;
    status.textContent = msg;
    status.className = `contact__status${kind ? ` is-${kind}` : ''}`;
  };

  // Result of a submission made without JavaScript (the server redirects back here).
  const params = new URLSearchParams(location.search);
  if (params.has('sent')) say('Thanks. Your message has been sent and we will reply by email.', 'ok');
  else if (params.has('error')) say(`Something went wrong. Please email us directly at ${form?.dataset.mailto}.`, 'error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    if (data.get('website')) return; // honeypot filled: silently drop

    const endpoint = form.dataset.endpoint;
    const mailto = form.dataset.mailto;

    if (endpoint) {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      say('Sending…');
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
        const body = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        if (res.ok && body?.ok) {
          form.reset();
          say(body.message || 'Thanks. Your message has been sent and we will reply by email.', 'ok');
        } else {
          say(`${body?.message || 'Something went wrong.'} You can also email us at ${mailto}.`, 'error');
        }
      } catch {
        say(`Could not send. Please email us directly at ${mailto}.`, 'error');
      } finally {
        if (button) button.disabled = false;
      }
      return;
    }

    // No endpoint configured: hand the message to the visitor's mail client.
    const subject = `${data.get('topic')} — from ${data.get('name')}`;
    const body = [
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      data.get('company') ? `Company: ${data.get('company')}` : '',
      '',
      String(data.get('message') ?? ''),
    ]
      .filter((line) => line !== '')
      .join('\n');
    window.location.href = `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    say('Opening your email app with the message ready to send.', 'ok');
  });
</script>

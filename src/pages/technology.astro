---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroArt from '../components/HeroArt.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import AiPipeline from '../components/AiPipeline.astro';
import Icon from '../components/Icon.astro';
import Illus from '../components/Illus.astro';
import CodeSample from '../components/CodeSample.astro';

const philosophy = [
  ['anchor', 'Boring where it matters', 'Databases, hosting and build tooling are chosen for reliability and a long support horizon, not novelty. Innovation goes into the product, not the plumbing.'],
  ['repeat', 'Small, frequent releases', 'Changes ship in small pieces behind automated checks. A release is routine, not an event.'],
  ['activity', 'Measured, not assumed', 'Performance budgets, error rates and user-facing latency are tracked from the first deployment. If it is not measured we do not claim it.'],
  ['book', 'Written down', 'Architecture decisions, runbooks and onboarding notes live with the code. The next engineer should not need to ask.'],
] as const;

const stack = [
  { area: 'Languages and frameworks', items: ['TypeScript', 'Node.js', 'React and Next.js', 'Astro', 'Python for data and ML work'] },
  { area: 'Data', items: ['PostgreSQL', 'Redis', 'Object storage', 'Vector search where retrieval needs it'] },
  { area: 'Infrastructure', items: ['Containers', 'Infrastructure as code', 'Multi-region cloud hosting', 'CDN and edge caching'] },
  { area: 'AI and machine learning', items: ['Large language model APIs', 'Retrieval-augmented generation', 'Evaluation harnesses', 'Human review workflows'] },
  { area: 'Quality', items: ['Automated testing', 'Continuous integration', 'Dependency and secret scanning', 'Accessibility checks'] },
  { area: 'Operations', items: ['Structured logging and tracing', 'Uptime and error monitoring', 'Backups with tested restores', 'Incident runbooks'] },
];

const practices = [
  ['code', 'Code review on everything', 'No change reaches production without a second pair of eyes. Reviews look for clarity as much as correctness.'],
  ['check', 'Continuous integration', 'Lint, type-check, unit and integration tests on every push. A red build blocks the merge.'],
  ['layers', 'Feature flags and staged rollouts', 'New behaviour ships dark, turns on for a few users first, and can be switched off in seconds.'],
  ['shield', 'Dependency hygiene', 'Automated updates and scanning. Known vulnerabilities are patched within days, not quarters.'],
  ['gauge', 'Performance budgets', 'Page weight, Core Web Vitals and API latency have numbers attached. Regressions fail the build.'],
  ['file-text', 'Post-incident reviews', 'When something breaks we write down what happened, why, and what changed. Blameless, and shared.'],
] as const;

const ai = [
  ['Start with the job', 'We define the task, the inputs and what a correct output looks like before choosing a model.'],
  ['Ground it in your data', 'Retrieval over your own documents and records, so answers cite something real rather than guessing.'],
  ['Evaluate continuously', 'A test set of real examples is scored on every change, so quality is a number we watch, not an impression.'],
  ['Keep a person in the loop', 'Outputs are reviewable, editable and logged. Where the stakes are high, nothing is sent or saved without a human decision.'],
];
---

<Base
  title="Technology"
  description="How Insoftica builds software: engineering philosophy, the technology stack behind our products, delivery practices, and a practical, evaluated approach to applying AI."
>
  <PageHero
    eyebrow="Technology"
    title="Engineering principles that outlast any particular tool."
    lead="This page explains how we build, what we build with and how we approach AI. Tools change; the standards do not."
  >
    <HeroArt name="technology" />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Engineering philosophy</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Four habits behind every Insoftica product.</h2>
      </div>
      <div class="grid grid--2 phil">
        {
          philosophy.map(([icon, t, d], i) => (
            <div class="phil__item reveal" style={`--reveal-delay:${i * 70}ms`}>
              <span class="phil__icon" aria-hidden="true"><Icon name={icon} size={22} /></span>
              <div>
                <span class="phil__num">0{i + 1}</span>
                <h3 class="h3">{t}</h3>
                <p>{d}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Reference architecture</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">The shape most of our systems take.</h2>
        <p class="lead reveal" style="--reveal-delay:120ms">Boring on purpose. Each box is a well-understood component with a long support horizon, so the interesting work can happen in the product.</p>
      </div>
      <div class="arch-wrap reveal">
        <ArchitectureDiagram />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Delivery practices</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">How work actually gets to production.</h2>
      </div>
      <div class="grid grid--3">
        {
          practices.map(([icon, t, d], i) => (
            <div class="card card--lift practice reveal" style={`--reveal-delay:${i * 70}ms`}>
              <span class="practice__icon"><Icon name={icon} size={20} /></span>
              <h3 class="h4">{t}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">The stack</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">What we build with.</h2>
        <p class="lead reveal" style="--reveal-delay:120ms">
          A deliberately small set of well-understood tools. We add to it when a product needs something, not when something is fashionable.
        </p>
      </div>
      <div class="grid grid--3 stack">
        {
          stack.map((s, i) => (
            <div class="stack__group reveal" style={`--reveal-delay:${i * 60}ms`}>
              <h3>{s.area}</h3>
              <ul role="list">
                {s.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section dots" id="ai" style="scroll-margin-top:110px">
    <div class="container ai">
      <div class="section-head reveal">
        <p class="eyebrow">Applied AI</p>
        <h2 class="h2">AI that does a job, and can show its work.</h2>
        <p class="lead">
          We treat language models as a powerful but fallible component. The engineering around them is what makes a product trustworthy.
        </p>
      </div>
      <div class="ai__pipe reveal">
        <AiPipeline />
      </div>
      <div class="rows reveal" style="--reveal-delay:80ms">
        {
          ai.map(([t, d], i) => (
            <div class="row">
              <span class="row__num">0{i + 1}</span>
              <span class="row__title">{t}</span>
              <span class="row__text">{d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt evals">
    <div class="container evals__inner">
      <div class="reveal">
        <p class="eyebrow">Evaluation in practice</p>
        <h2 class="h2">Quality is a number we watch on every change.</h2>
        <p class="lead" style="margin-top:16px">Each AI feature ships with a test set of real examples. Every change is scored against it before it can be released, so a regression is caught by a build, not by a customer.</p>
        <p class="evals__note">The code shown is a simplified example of the pattern, not a product.</p>
      </div>
      <div class="reveal" style="--reveal-delay:100ms">
        <CodeSample title="evaluate.ts" lang="ts">
<span class="k">import</span> {'{'} evaluate, loadCases {'}'} <span class="k">from</span> <span class="s">'./harness'</span>;

<span class="k">const</span> cases = <span class="k">await</span> <span class="f">loadCases</span>(<span class="s">'support-assistant/v3'</span>); <span class="c">// 240 real questions</span>

<span class="k">const</span> result = <span class="k">await</span> <span class="f">evaluate</span>(cases, {'{'}
  checks: [<span class="s">'answer-matches-source'</span>, <span class="s">'cites-at-least-one'</span>, <span class="s">'no-pii-leak'</span>],
  threshold: <span class="n">0.95</span>,
{'}'});

<span class="k">if</span> (!result.passed) {'{'}
  <span class="c">// The build fails here. Nothing ships.</span>
  <span class="k">throw new</span> <span class="f">Error</span>(<span class="s">`Accuracy ${'{'}result.score{'}'} below threshold`</span>);
{'}'}
        </CodeSample>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container sec">
      <div class="section-head reveal">
        <p class="eyebrow">Security and privacy</p>
        <h2 class="h2">Defaults, not add-ons.</h2>
      </div>
      <div class="sec__art reveal"><Illus name="security" /></div>
      <div class="grid grid--2 reveal" style="--reveal-delay:80ms">
        <div class="card card--lift">
          <h3 class="h3">In the code</h3>
          <p>Least-privilege access, secrets kept out of repositories, dependencies scanned on every build, input validated at the boundary, and encryption in transit and at rest.</p>
        </div>
        <div class="card card--lift">
          <h3 class="h3">In the organisation</h3>
          <p>Data kept in the region you choose, access reviewed regularly, backups restored and tested on a schedule, and a written plan for when something goes wrong.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .phil {
    --grid-gap: 0;
    border-top: 1px solid var(--line);
  }

  .phil__item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 32px 32px 32px 0;
    border-bottom: 1px solid var(--line);
  }

  .phil__item:nth-child(2n) {
    padding-left: 32px;
    padding-right: 0;
    border-left: 1px solid var(--line);
  }

  .phil__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--indigo-tint);
    color: var(--indigo);
  }

  .phil__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--slate-light);
    margin-bottom: 6px;
  }

  .phil__item h3 {
    margin-bottom: 8px;
  }

  .phil__item p {
    color: var(--slate);
  }

  .arch-wrap {
    padding: clamp(16px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .practice__icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--indigo-tint);
    color: var(--indigo);
    margin-bottom: 16px;
  }

  .practice p {
    margin-top: 8px;
  }

  .stack {
    --grid-gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .stack__group {
    padding: 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stack__group:nth-child(3n) {
    border-right: 0;
  }

  .stack__group:nth-last-child(-n + 3) {
    border-bottom: 0;
  }

  .stack__group h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--indigo);
    margin-bottom: 16px;
  }

  .stack__group li {
    padding: 7px 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ai .section-head {
    margin-bottom: 40px;
  }

  .ai__pipe {
    margin-bottom: 56px;
  }

  .sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .sec .section-head {
    margin-bottom: 0;
  }

  .sec__art {
    grid-row: span 2;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .sec .grid--2 {
    grid-column: 1;
  }

  .evals__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .evals__inner > * {
    min-width: 0;
  }

  .evals__note {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--slate-light);
  }

  @media (max-width: 720px) {
    .phil__item,
    .phil__item:nth-child(2n) {
      padding: 24px 0;
      border-left: 0;
    }
  }

  @media (max-width: 960px) {
    .sec,
    .evals__inner {
      grid-template-columns: 1fr;
    }

    .sec__art {
      grid-row: auto;
    }
  }

  @media (max-width: 960px) {
    .stack__group:nth-child(3n) {
      border-right: 1px solid var(--line);
    }

    .stack__group:nth-child(2n) {
      border-right: 0;
    }

    .stack__group:nth-last-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }

    .stack__group:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .stack__group,
    .stack__group:nth-child(2n),
    .stack__group:nth-child(3n) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .stack__group:last-child {
      border-bottom: 0;
    }
  }
</style>

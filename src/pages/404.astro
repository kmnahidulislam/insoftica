---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="The page you were looking for does not exist.">
  <section class="section nf dots">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h1">That page doesn't exist.</h1>
      <p class="lead">It may have moved, or the link may be wrong. The pages below are a good place to start.</p>
      <div class="btn-row">
        <a href="/" class="btn btn--primary">
          Home
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="/products" class="btn btn--ghost">Products</a>
        <a href="/contact" class="btn btn--ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .nf .eyebrow {
    margin-bottom: 20px;
  }

  .nf .lead {
    max-width: 48ch;
    margin: 20px 0 32px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const links = [
  ['/', 'Home', 'Who we are and what we build'],
  ['/products', 'Products', 'What is live, in early access and in development'],
  ['/solutions', 'Solutions', 'Software and AI engineering for your business'],
  ['/contact', 'Contact', 'Talk to us about anything'],
];
---

<Base title="Page not found" description="The page you were looking for does not exist.">
  <section class="section nf dots">
    <div class="container nf__grid">
      <div class="nf__copy">
        <p class="eyebrow reveal">Error 404</p>
        <h1 class="h1 reveal" style="--reveal-delay:60ms">
          This page doesn't <span class="hl">exist</span>.
        </h1>
        <p class="lead reveal" style="--reveal-delay:120ms">
          There's nothing at <code class="nf__path" data-path>this address</code>. It may have moved, or the link may be wrong.
          Nothing is broken on our side, and the pages below are a good place to continue.
        </p>
        <p class="nf__suggest reveal" data-suggest hidden style="--reveal-delay:150ms">
          Did you mean <a data-suggest-link href="/"></a>?
        </p>
        <div class="btn-row reveal" style="--reveal-delay:180ms">
          <a href="/" class="btn btn--primary">
            Back to home
            <Icon name="arrow-right" size={16} />
          </a>
          <button type="button" class="btn btn--ghost" data-back hidden>Go back</button>
          <a href={`mailto:${site.email}?subject=Broken%20link`} class="btn btn--ghost" data-report>Report a broken link</a>
        </div>

        <ul class="nf__links reveal" role="list" style="--reveal-delay:240ms">
          {links.map(([href, label, text]) => (
            <li>
              <a href={href}>
                <span class="nf__link-label">{label}</span>
                <span class="nf__link-text">{text}</span>
                <Icon name="arrow-up-right" size={16} class="nf__link-icon" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <figure class="nf__art" data-diagram aria-hidden="true">
        <svg viewBox="0 0 560 420" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <clipPath id="nf-win"><rect x="60" y="48" width="440" height="300" rx="16" /></clipPath>
          </defs>

          <!-- browser window -->
          <g class="nf-d1">
            <rect x="60" y="48" width="440" height="300" rx="16" class="nf-win" />
            <rect x="60" y="48" width="440" height="40" class="nf-bar" clip-path="url(#nf-win)" />
            <circle cx="82" cy="68" r="4" class="nf-dot" />
            <circle cx="96" cy="68" r="4" class="nf-dot" />
            <circle cx="110" cy="68" r="4" class="nf-dot" />
            <rect x="140" y="58" width="300" height="20" rx="10" class="nf-url" />
            <text x="154" y="72" class="nf-url-text">insoftica.com/<tspan class="nf-url-miss">this-page</tspan></text>
            <line x1="60" y1="88" x2="500" y2="88" class="nf-line" />
          </g>

          <!-- the big number (behind the route map) -->
          <text x="280" y="322" class="nf-404 nf-d4">404</text>

          <!-- route map: home -> products -> ??? -->
          <g class="nf-d2">
            <path d="M120 230 C 170 230, 180 160, 240 160" class="nf-route" />
            <path d="M240 160 C 300 160, 300 250, 360 250" class="nf-route" />
            <path d="M360 250 C 390 250, 400 200, 420 190" class="nf-route nf-route--broken" />

            <g transform="translate(120 230)">
              <circle r="18" class="nf-node" />
              <path d="M-6 2v6h12v-6M-8 2l8-7 8 7" class="nf-glyph" />
            </g>
            <g transform="translate(240 160)">
              <circle r="18" class="nf-node" />
              <path d="M-7 -5h14v11h-14zM-7 -5l7-4 7 4M0 -9v4" class="nf-glyph" />
            </g>
            <g transform="translate(360 250)">
              <circle r="18" class="nf-node nf-node--mid" />
              <path d="M-6 -6h12M-6 0h12M-6 6h7" class="nf-glyph" />
            </g>
          </g>

          <!-- the missing destination -->
          <g class="nf-d3" transform="translate(432 182)">
            <circle r="30" class="nf-pulse" />
            <circle r="30" class="nf-pulse nf-pulse--late" />
            <circle r="22" class="nf-node nf-node--missing" />
            <text y="6" class="nf-q">?</text>
          </g>

          <!-- chips -->
          <g class="nf-chip nf-d5" transform="translate(28 300)">
            <rect width="150" height="54" rx="12" />
            <text x="16" y="22" class="nf-chip-k">STATUS</text>
            <text x="16" y="42" class="nf-chip-v"><tspan class="nf-chip-bad">404</tspan> Not found</text>
          </g>
          <g class="nf-chip nf-d6" transform="translate(386 326)">
            <rect width="150" height="54" rx="12" />
            <text x="16" y="22" class="nf-chip-k">EVERYTHING ELSE</text>
            <text x="16" y="42" class="nf-chip-v"><tspan class="nf-chip-ok">●</tspan> Working</text>
          </g>

        </svg>
      </figure>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
  }

  .nf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .nf .eyebrow {
    margin-bottom: 20px;
    color: var(--indigo);
  }

  .nf [hidden] {
    display: none;
  }

  .nf .lead {
    max-width: 48ch;
    margin: 20px 0 32px;
  }

  .nf__suggest {
    margin: -16px 0 28px;
    font-size: 1.02rem;
    color: var(--slate);
  }

  .nf__suggest a {
    font-weight: 600;
    color: var(--indigo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nf__path {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--canvas-2);
    border: 1px solid var(--line);
    color: var(--ink);
    word-break: break-all;
  }

  .nf__links {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .nf__links a {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 40px 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.2s var(--ease), translate 0.2s var(--ease);
  }

  .nf__links a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
    translate: 0 -2px;
  }

  .nf__link-label {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nf__link-text {
    font-size: 0.85rem;
    color: var(--slate);
  }

  .nf__links :global(.nf__link-icon) {
    position: absolute;
    right: 14px;
    top: 16px;
    color: var(--slate-light);
    transition: color 0.15s, translate 0.2s var(--ease);
  }

  .nf__links a:hover :global(.nf__link-icon) {
    color: var(--indigo);
    translate: 2px -2px;
  }

  /* Illustration */
  .nf__art {
    margin: 0;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .nf__art svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    font-family: var(--font-sans);
  }

  .nf-win { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; filter: drop-shadow(0 18px 30px rgba(14, 15, 42, 0.1)); }
  .nf-bar { fill: var(--canvas-2); }
  .nf-dot { fill: var(--line-strong); }
  .nf-url { fill: var(--surface); stroke: var(--line); }
  .nf-url-text { font-family: var(--font-mono); font-size: 10.5px; fill: var(--slate); }
  .nf-url-miss { fill: var(--ink); text-decoration: line-through; }
  .nf-line { stroke: var(--line); stroke-width: 1.5; }

  .nf-route { fill: none; stroke: var(--indigo); stroke-width: 2; stroke-dasharray: 4 6; opacity: 0.6; }
  .nf-route--broken { stroke: var(--amber); stroke-dasharray: 2 8; }
  .nf-node { fill: var(--surface); stroke: var(--indigo); stroke-width: 2; }
  .nf-node--mid { stroke: var(--line-strong); }
  .nf-node--missing { fill: var(--surface); stroke: var(--amber); stroke-dasharray: 4 4; }
  .nf-glyph { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .nf-q { font-family: var(--font-display); font-size: 22px; font-weight: 700; fill: var(--amber); text-anchor: middle; }
  .nf-pulse { fill: var(--amber); opacity: 0; transform-origin: 0 0; animation: nf-pulse 2.6s ease-out infinite; }
  .nf-pulse--late { animation-delay: 1.3s; }

  .nf-404 {
    font-family: var(--font-display);
    font-size: 150px;
    font-weight: 800;
    letter-spacing: -0.05em;
    text-anchor: middle;
    fill: none;
    stroke: var(--indigo);
    stroke-width: 1.5;
    opacity: 0.22;
  }

  .nf-chip rect { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; filter: drop-shadow(0 8px 16px rgba(14, 15, 42, 0.08)); }
  .nf-chip-k { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; fill: var(--slate-light); }
  .nf-chip-v { font-size: 13px; font-weight: 600; fill: var(--ink); letter-spacing: -0.01em; }
  .nf-chip-bad { fill: var(--amber); }
  .nf-chip-ok { fill: var(--signal); }


  @keyframes nf-pulse {
    0% { transform: scale(0.4); opacity: 0.35; }
    100% { transform: scale(1.5); opacity: 0; }
  }


  .nf-d1, .nf-d2, .nf-d3, .nf-d4, .nf-d5, .nf-d6 {
    opacity: 0;
    translate: 0 14px;
    transition: opacity 0.7s var(--ease), translate 0.7s var(--ease);
  }
  .nf-d2 { transition-delay: 0.12s; }
  .nf-d3 { transition-delay: 0.24s; }
  .nf-d4 { transition-delay: 0.36s; }
  .nf-d5 { transition-delay: 0.48s; }
  .nf-d6 { transition-delay: 0.6s; }
  .nf__art.is-visible :is(.nf-d1, .nf-d2, .nf-d3, .nf-d4, .nf-d5, .nf-d6) { opacity: 1; translate: 0 0; }

  @media (max-width: 900px) {
    .nf__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .nf__art {
      order: -1;
      max-width: 440px;
    }

    .nf-404 { font-size: 130px; }
  }

  @media (max-width: 520px) {
    .nf__links {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Show the address that was requested, and offer "Go back" when there is history.
  const pathEl = document.querySelector<HTMLElement>('[data-path]');
  const path = location.pathname + location.search;
  const isReal = path && path !== '/404' && path !== '/404.html';
  if (pathEl && isReal) pathEl.textContent = decodeURIComponent(path);

  // Suggest the closest real page for a near-miss address such as /product or /contact-us.
  const pages: [string, string][] = [
    ['/', 'the home page'], ['/products', 'Products'], ['/solutions', 'Solutions'],
    ['/technology', 'Technology'], ['/about', 'About'], ['/contact', 'Contact'],
    ['/privacy', 'Privacy'], ['/terms', 'Terms'],
  ];
  const distance = (a: string, b: string) => {
    const m = a.length, n = b.length;
    const d = Array.from({ length: m + 1 }, (_, i) => [i, ...Array(n).fill(0)]);
    for (let j = 1; j <= n; j++) d[0][j] = j;
    for (let i = 1; i <= m; i++)
      for (let j = 1; j <= n; j++)
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    return d[m][n];
  };
  if (isReal) {
    const slug = '/' + location.pathname.toLowerCase().replace(/\.html?$/, '').split('/').filter(Boolean)[0]?.replace(/[-_]?(us|page)$/, '') || '';
    let best: [string, string] | null = null;
    let bestScore = Infinity;
    for (const page of pages) {
      if (page[0] === '/') continue;
      const score = distance(slug, page[0]);
      const ok = score <= Math.max(2, Math.floor(page[0].length / 3)) || page[0].startsWith(slug.slice(0, 4)) && slug.length >= 4;
      if (ok && score < bestScore) { best = page; bestScore = score; }
    }
    const box = document.querySelector<HTMLElement>('[data-suggest]');
    const link = document.querySelector<HTMLAnchorElement>('[data-suggest-link]');
    if (best && box && link) {
      link.href = best[0];
      link.textContent = best[1];
      box.hidden = false;
    }
  }

  // Put the broken address in the report email so it can be fixed.
  const report = document.querySelector<HTMLAnchorElement>('[data-report]');
  if (report && isReal) report.href += '&body=' + encodeURIComponent('This address shows a 404 page: ' + location.href);

  const back = document.querySelector<HTMLButtonElement>('[data-back]');
  if (back && history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) {
    back.hidden = false;
    back.addEventListener('click', () => history.back());
  }
</script>

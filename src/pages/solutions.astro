---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Illus from '../components/Illus.astro';
import CodeSample from '../components/CodeSample.astro';
import { site } from '../data/site';

const spotlights = [
  { illus: 'search', eyebrow: 'AI-powered solutions', title: 'Assistants that cite their sources.', text: 'We connect a language model to your own documents and records, so every answer points at where it came from. Staff check the citation, not the whole document, and the model never sees data it is not allowed to.', points: ['Retrieval over your data, with permissions respected', 'Evaluation set scored on every change', 'Review step before anything is sent or saved'] },
  { illus: 'billing', eyebrow: 'SaaS platforms', title: 'Billing that survives contact with real customers.', text: 'Plans, trials, upgrades mid-cycle, usage metering, failed payments, VAT across borders. We build subscription products with the operational side designed in, not bolted on.', points: ['Multi-tenant from the first line of code', 'Usage metering and invoices that reconcile', 'Admin tools for your support team'] },
  { illus: 'automation', eyebrow: 'Workflow automation', title: 'Remove the repetitive steps, keep the audit trail.', text: 'Rules, queues and scheduled jobs that take over the copy-and-paste work between systems, with every action logged so a person can always see what happened and why.', points: ['Triggers from webhooks, schedules or user actions', 'Retries and dead-letter handling built in', 'A log that explains every automated decision'] },
] as const;

const clients = [
  ['box', 'Founders with a product to build', 'You have the idea, the market and the first customers lined up. You need a team that can take it from brief to launch and stay to run it.'],
  ['building', 'Growing businesses outgrowing their tools', 'Spreadsheets, shared inboxes and off-the-shelf apps have stopped fitting. You need software shaped around how the business actually works.'],
  ['layers', 'Established companies adding AI', 'You have data, processes and a clear job for AI to do. You want it done carefully, with evaluation and review, not a demo that never ships.'],
  ['code', 'Technical teams that need senior capacity', 'You have engineers, but not enough of them, or not for this. Ours work in your repositories and your process for as long as needed.'],
] as const;

const faq: [string, string][] = [
  ['How long does a typical project take?', 'A focused web application usually takes eight to sixteen weeks to first release. Larger platforms are delivered in phases of similar length so there is always something usable.'],
  ['Can you work with our existing codebase?', 'Yes. We start with a short review to understand it, then work incrementally. We avoid rewrites unless the case for one is clear and written down.'],
  ['What happens after launch?', 'You can take the system in-house with full handover, or we can keep operating it under a monthly agreement that covers monitoring, updates and improvements.'],
  ['Do you sign NDAs?', 'Yes, before any detailed conversation if you prefer. Send yours or ask for ours.'],
];

const solutions = [
  {
    id: 'custom-software',
    icon: 'code',
    title: 'Custom software engineering',
    text: 'Applications built around how your organisation actually works, when off-the-shelf tools stop fitting. Web-based, maintainable and documented.',
    points: ['Internal tools and back-office systems', 'Customer portals and dashboards', 'Replacing spreadsheets and manual processes'],
  },
  {
    id: 'ai',
    icon: 'sparkle',
    title: 'AI-powered solutions',
    text: 'Language models and machine learning applied to a specific job in your business, with outputs people can check and a clear measure of whether it is working.',
    points: ['Assistants for drafting, summarising and search', 'Document and data extraction', 'Classification and routing of requests'],
  },
  {
    id: 'web',
    icon: 'monitor',
    title: 'Web applications',
    text: 'Fast, accessible web applications with a clean interface, built on a modern stack and hosted on infrastructure we can monitor and scale.',
    points: ['Multi-user applications with roles and permissions', 'Public-facing sites and portals', 'Progressive web apps for mobile use'],
  },
  {
    id: 'saas',
    icon: 'layers',
    title: 'SaaS platform development',
    text: 'Subscription products from the ground up: tenancy, billing, onboarding, admin tooling and the operational side that is easy to underestimate.',
    points: ['Multi-tenant architecture', 'Subscription billing and plans', 'Usage metering, audit logs and admin'],
  },
  {
    id: 'integration',
    icon: 'plug',
    title: 'API and systems integration',
    text: 'Connecting the systems you already run so data moves without copy-and-paste: payment providers, CRMs, accounting tools, internal databases.',
    points: ['REST and webhook integrations', 'Data pipelines and synchronisation', 'Public APIs for your own customers'],
  },
  {
    id: 'modernisation',
    icon: 'gauge',
    title: 'Modernisation and performance',
    text: 'Bringing an existing application up to current standards: faster, more secure, easier to change, without a risky rewrite.',
    points: ['Performance audits and fixes', 'Incremental migration of legacy code', 'Security and dependency hygiene'],
  },
] as const;

const fit = [
  ['A specific problem', 'You can describe what is slow, manual or missing today, and what better would look like.'],
  ['A person who owns it', 'Someone on your side who can make decisions and test what we build.'],
  ['A long view', 'You want software that is still working and improving in three years, not a one-off build.'],
];
---

<Base
  title="Solutions"
  description="Software engineering and AI-powered solutions from Insoftica: custom software, web applications, SaaS platforms, API integrations and modernisation for businesses in the UK and internationally."
  faq={faq}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: 'Software development and AI solutions',
      provider: { '@type': 'Organization', name: site.legalName, url: site.url },
      areaServed: ['GB', 'Worldwide'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Insoftica solutions',
        itemListElement: solutions.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.text } })),
      },
    },
  ]}
>
  <PageHero
    eyebrow="Solutions for businesses"
    title="The same engineering we use on our own products, applied to yours."
    lead="Insoftica is a product company first, and that is exactly why businesses work with us: the code, infrastructure and AI practices behind our products are the ones we bring to your project."
  >
    <div class="panel">
      <p class="panel__title">Every engagement includes</p>
      <ul role="list">
        <li><Icon name="check" size={16} /> Senior engineers from the first call to handover</li>
        <li><Icon name="check" size={16} /> A written proposal with scope, timeline and cost</li>
        <li><Icon name="check" size={16} /> Working software in the first weeks, then weekly releases</li>
        <li><Icon name="check" size={16} /> Full ownership of code, infrastructure and documentation</li>
        <li><Icon name="check" size={16} /> Data hosted in UK and EU regions by default</li>
      </ul>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="grid grid--2 sol__grid">
        {
          solutions.map((s, i) => (
            <article id={s.id} class="card card--lift sol reveal" style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <span class="sol__icon">
                <Icon name={s.icon} size={22} />
              </span>
              <h2 class="h3">{s.title}</h2>
              <p>{s.text}</p>
              <ul role="list" class="sol__points">
                {s.points.map((p) => (
                  <li>
                    <Icon name="check" size={14} />
                    {p}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">In practice</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Three of the problems we solve most often.</h2>
      </div>
      <div class="spots">
        {
          spotlights.map((sp, i) => (
            <div class="spot reveal" style={`--reveal-delay:${i * 80}ms`}>
              <div class="spot__art"><Illus name={sp.illus} /></div>
              <div class="spot__copy">
                <p class="eyebrow">{sp.eyebrow}</p>
                <h3 class="h2">{sp.title}</h3>
                <p class="spot__text">{sp.text}</p>
                <ul role="list" class="spot__points">
                  {sp.points.map((pt) => (
                    <li><Icon name="check" size={14} /> {pt}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section api">
    <div class="container api__inner">
      <div class="reveal">
        <p class="eyebrow">API and integration</p>
        <h2 class="h2">Every system we build has a clean API.</h2>
        <p class="lead" style="margin-top:16px">Typed, versioned, documented and authenticated. Your other tools, and ours, talk to it the same way.</p>
        <ul role="list" class="api__points">
          <li><Icon name="check" size={14} /> REST endpoints with OpenAPI documentation</li>
          <li><Icon name="check" size={14} /> Webhooks with signatures and retries</li>
          <li><Icon name="check" size={14} /> Per-client keys, rate limits and audit logs</li>
        </ul>
      </div>
      <div class="reveal" style="--reveal-delay:100ms">
        <CodeSample title="create-invoice.ts" lang="ts">
<span class="c">// Example of the kind of client we generate for every API</span>
<span class="k">import</span> {'{'} InsofticaClient {'}'} <span class="k">from</span> <span class="s">'@your-company/api'</span>;

<span class="k">const</span> api = <span class="k">new</span> <span class="f">InsofticaClient</span>({'{'} apiKey: process.env.<span class="n">API_KEY</span> {'}'});

<span class="k">const</span> invoice = <span class="k">await</span> api.invoices.<span class="f">create</span>({'{'}
  customerId: <span class="s">'cus_8f2k'</span>,
  currency: <span class="s">'GBP'</span>,
  lines: [{'{'} description: <span class="s">'Pro plan, November'</span>, amount: <span class="n">4900</span> {'}'}],
{'}'});

<span class="c">// Webhook arrives when it is paid; signature is verified for you</span>
api.webhooks.<span class="f">on</span>(<span class="s">'invoice.paid'</span>, <span class="k">async</span> (event) =&gt; {'{'}
  <span class="k">await</span> ledger.<span class="f">record</span>(event.data);
{'}'});
        </CodeSample>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Who we work with</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Four situations we are set up for.</h2>
      </div>
      <div class="grid grid--2 clients">
        {
          clients.map(([icon, t, d], i) => (
            <div class="client reveal" style={`--reveal-delay:${i * 70}ms`}>
              <span class="client__icon"><Icon name={icon} size={20} /></span>
              <div>
                <h3 class="h3">{t}</h3>
                <p>{d}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section on-dark dots">
    <div class="container fit">
      <div class="section-head reveal">
        <p class="eyebrow">Working together</p>
        <h2 class="h2">What a good fit looks like.</h2>
        <p class="lead">We take on a small number of projects so each one gets senior attention. These three things make a project work.</p>
      </div>
      <div class="rows reveal" style="--reveal-delay:80ms">
        {
          fit.map(([t, d], i) => (
            <div class="row">
              <span class="row__num">0{i + 1}</span>
              <span class="row__title">{t}</span>
              <span class="row__text">{d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container how">
      <div class="section-head reveal">
        <p class="eyebrow">How an engagement runs</p>
        <h2 class="h2">Short, clear and in writing.</h2>
      </div>
      <ol role="list" class="how__steps reveal" style="--reveal-delay:80ms">
        <li>
          <strong>A conversation.</strong>
          <span>Tell us about the problem. We will say honestly whether we are the right people for it.</span>
        </li>
        <li>
          <strong>A written proposal.</strong>
          <span>Scope, approach, timeline and cost, in plain English. No surprises later.</span>
        </li>
        <li>
          <strong>Working software early.</strong>
          <span>Something usable within the first weeks, then regular releases you can see and test.</span>
        </li>
        <li>
          <strong>Handover or ongoing care.</strong>
          <span>Full source, documentation and infrastructure access are yours. We can keep operating it if you prefer.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container faq-wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h2">Common questions about working with us.</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .sol__grid {
    --grid-gap: 20px;
  }

  .sol__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--indigo-tint);
    color: var(--indigo);
    margin-bottom: 22px;
  }

  .sol__points {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 8px;
  }

  .sol__points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.925rem;
    color: var(--ink);
  }

  .sol__points svg {
    color: var(--indigo);
    flex-shrink: 0;
  }

  .spots {
    display: grid;
    gap: 24px;
  }

  .spot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    padding: clamp(24px, 3.5vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .spot:nth-child(even) .spot__art {
    order: 2;
  }

  .spot__art {
    padding: 12px 20px;
    border-radius: 14px;
    background: var(--canvas-2);
  }

  .spot__copy .eyebrow {
    margin-bottom: 14px;
  }

  .spot__copy h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .spot__text {
    margin-top: 14px;
    color: var(--slate);
  }

  .spot__points {
    margin-top: 18px;
    display: grid;
    gap: 8px;
  }

  .spot__points li,
  .api__points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .spot__points svg,
  .api__points svg {
    color: var(--indigo);
    flex-shrink: 0;
  }

  .api__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .api__inner > * {
    min-width: 0;
  }

  .api__points {
    margin-top: 22px;
    display: grid;
    gap: 10px;
  }

  .clients {
    --grid-gap: 28px 48px;
  }

  .client {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .client__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--indigo);
  }

  .client h3 {
    margin-bottom: 6px;
  }

  .client p {
    color: var(--slate);
  }

  .fit .section-head {
    margin-bottom: 40px;
  }

  .how {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(32px, 6vw, 96px);
  }

  .how .section-head {
    margin-bottom: 0;
  }

  .how__steps {
    counter-reset: step;
    display: grid;
    gap: 0;
  }

  .how__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 8px 16px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .how__steps li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .how__steps li::before {
    content: '0' counter(step);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--indigo);
    padding-top: 3px;
    grid-row: span 2;
  }

  .how__steps strong {
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }

  .how__steps span {
    grid-column: 2;
    color: var(--slate);
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .faq-wrap .section-head {
    margin-bottom: 0;
  }

  .sol {
    scroll-margin-top: 96px;
  }

  @media (max-width: 860px) {
    .spot,
    .api__inner,
    .faq-wrap {
      grid-template-columns: 1fr;
    }

    .spot:nth-child(even) .spot__art {
      order: 0;
    }

    .how {
      grid-template-columns: 1fr;
    }
  }
</style>

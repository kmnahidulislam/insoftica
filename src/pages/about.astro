---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import MapMark from '../components/MapMark.astro';
import { site, addressLines } from '../data/site';

const principles = [
  ['Useful before impressive', 'A product earns its place by solving a real problem well. Novelty is not a feature.'],
  ['Engineered to last', 'We build for the years after launch: readable code, boring infrastructure, automated tests, clear ownership.'],
  ['AI where it earns its place', 'Language models and machine learning go into a product when they make it measurably better, not because they are available.'],
  ['The user stays in control', 'Automated and AI-generated output is shown, explained and reversible. People make the final decision.'],
  ['Clear about what is real', 'We describe what exists. Concepts are labelled as concepts. Products are announced when they can be used.'],
];

const timeline = [
  ['2026', 'Company founded in London', 'Insoftica Ltd is incorporated with a product-first remit: build and operate software of our own, and bring the same engineering to businesses.'],
  ['2026', 'Foundations built', 'Engineering standards, infrastructure templates, evaluation tooling for AI features, and this website. The groundwork every product will reuse.'],
  ['Next', 'First product reaches early access', 'A small group of invited users gets the first Insoftica product while it is refined. Details are published on the Products page when ready.'],
  ['Then', 'A growing portfolio', 'More products across AI-assisted tools, SaaS for growing businesses and developer tooling, each operated and improved for the long term.'],
];

const contrasts = [
  ['An outsourcing shop', 'A product company', 'We measure ourselves on what we ship and run, not on billable hours.'],
  ['An AI wrapper', 'Applied engineering', 'Models sit inside products with retrieval, evaluation and review around them. The model is a component, not the product.'],
  ['A volume agency', 'A small senior team', 'We take on a limited number of projects so each one gets experienced engineers from start to finish.'],
];

const facts = [
  ['3', 'product areas in active development'],
  ['6', 'engineering and AI solution types'],
  ['2', 'working days, our usual reply time', 'days'],
  ['100', 'of the code we write for you is yours', '%'],
];
---

<Base
  title="About"
  description="Insoftica Ltd is a London technology company building software products and AI-powered tools for an international audience. Learn about our mission, principles and how we work."
>
  <PageHero
    eyebrow="About Insoftica"
    title="A technology company organised around products."
    lead="Insoftica Ltd was founded in London to build and operate software products and AI-powered tools, and to bring the same engineering to businesses that need platforms built properly."
  >
    <HeroArt name="about" />
  </PageHero>

  <section class="section">
    <div class="container about__grid">
      <div class="reveal">
        <p class="eyebrow">Why Insoftica exists</p>
        <h2 class="h2">Software that someone is responsible for.</h2>
      </div>
      <div class="prose reveal" style="--reveal-delay:80ms">
        <p>
          A lot of software is built quickly for someone else and then left behind. We started Insoftica to do
          the opposite: to build digital products we are responsible for, operate them well and keep improving
          them for the people who use them.
        </p>
        <p>
          That focus shapes everything else. The engineering practices we use on our own products are the ones
          we bring to work for other businesses. The AI capabilities we develop for ourselves become part of what
          we can build for them. Over time, the aim is a portfolio of Insoftica products used in the UK and
          internationally, and a company recognised for the quality of what it ships.
        </p>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container stats">
      {
        facts.map(([v, l, suffix], i) => (
          <div class="stat reveal" style={`--reveal-delay:${i * 70}ms`}>
            <div class="stat__value"><span data-count={v}>{v}</span>{suffix && <small>{suffix}</small>}</div>
            <div class="stat__label">{l}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt mv">
    <div class="container grid grid--2">
      <div class="card card--lift reveal">
        <p class="eyebrow">Mission</p>
        <h2 class="h3 mv__title">To build software products and AI-powered tools that are genuinely useful, well engineered and a pleasure to use.</h2>
      </div>
      <div class="card card--lift reveal" style="--reveal-delay:80ms">
        <p class="eyebrow">Vision</p>
        <h2 class="h3 mv__title">A portfolio of Insoftica products used by people and businesses around the world, and a company known for the quality of what it builds.</h2>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Principles</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Five things we hold ourselves to.</h2>
      </div>
      <div class="rows">
        {
          principles.map(([t, d], i) => (
            <div class="row reveal" style={`--reveal-delay:${i * 60}ms`}>
              <span class="row__num">0{i + 1}</span>
              <span class="row__title">{t}</span>
              <span class="row__text">{d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container about__grid">
      <div class="reveal">
        <p class="eyebrow">Where we are</p>
        <h2 class="h2">Early, and building in the right order.</h2>
        <p class="lead" style="margin-top:16px">Foundations first, then products. The later steps are plans, not promises with dates.</p>
      </div>
      <ol role="list" class="timeline reveal" style="--reveal-delay:80ms">
        {
          timeline.map(([when, t, d]) => (
            <li>
              <span class="timeline__when">{when}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">What we are not</p>
        <h2 class="h2 reveal" style="--reveal-delay:60ms">Three easy things to mistake us for.</h2>
      </div>
      <div class="grid grid--3">
        {
          contrasts.map(([no, yes, d], i) => (
            <div class="card card--lift contrast reveal" style={`--reveal-delay:${i * 80}ms`}>
              <p class="contrast__no"><Icon name="x" size={14} /> {no}</p>
              <p class="contrast__yes"><Icon name="check" size={14} /> {yes}</p>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container about__grid">
      <div class="reveal">
        <p class="eyebrow">Company details</p>
        <h2 class="h2">The formal part.</h2>
        <div style="margin-top:24px"><MapMark /></div>
      </div>
      <div class="reveal" style="--reveal-delay:80ms">
        <dl class="details">
          <div><dt>Legal name</dt><dd>{site.legalName}</dd></div>
          <div><dt>Company status</dt><dd>Registered in England and Wales</dd></div>
          <div><dt>Registered office</dt><dd>{addressLines.join(', ')}</dd></div>
          <div><dt>Founded</dt><dd>{site.foundedYear}</dd></div>
          <div><dt>Focus</dt><dd>Software products, AI-powered tools, digital platforms</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }

  .about__grid .eyebrow {
    margin-bottom: 16px;
  }

  .prose p {
    font-size: 1.1rem;
    color: var(--slate);
  }

  .section--tight {
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .mv__title {
    margin-top: 16px;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    line-height: 1.35;
    font-weight: 600;
  }

  .contrast__no,
  .contrast__yes {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .contrast__no {
    color: var(--slate-light);
    text-decoration: line-through;
    text-decoration-color: rgba(85, 88, 112, 0.4);
  }

  .contrast__no svg {
    color: #c0392b;
  }

  .contrast__yes {
    color: var(--ink);
    margin: 6px 0 14px;
  }

  .contrast__yes svg {
    color: var(--signal);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 40px;
  }

  .details dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate-light);
    margin-bottom: 6px;
  }

  .details dd {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .details a {
    color: var(--indigo);
  }

  @media (max-width: 760px) {
    .about__grid,
    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
